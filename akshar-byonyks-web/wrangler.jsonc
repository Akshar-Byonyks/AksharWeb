{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "akshar-byonyks-web",

  // THE PUBLIC ADDRESSES, declared here rather than clicked into the
  // dashboard (4 Sep 2026, when the domain went live on Cloudflare).
  //
  // `custom_domain: true` is not the same thing as a route. A route matches
  // requests against a hostname that must already resolve somewhere; a custom
  // domain CREATES the DNS record and provisions the certificate, which is
  // what a Worker needs, because a Worker has no origin IP for an A record to
  // point at. That is also why the Namecheap parking records had to be
  // deleted first: this cannot claim a hostname another record already holds.
  //
  // IN CONFIG RATHER THAN IN THE UI so the site's addresses are reviewable in
  // the diff and reproducible on a rebuild. A domain attached by hand exists
  // only in one account's dashboard and is invisible to anyone reading this
  // repository to find out where the site actually lives.
  //
  // BOTH HOSTNAMES SERVE THE SAME WORKER, and www is not redirected. Every
  // page sets an absolute canonical from `metadataBase` in `app/layout.tsx`,
  // which is `siteUrl` — the apex — so a page served at www still tells search
  // engines the apex is the real one and the two are consolidated. A 301 would
  // need its own proxied placeholder record for www to hang off, to do a job
  // the canonicals already do correctly.
  "routes": [
    { "pattern": "aksharbyonyks.com", "custom_domain": true },
    { "pattern": "www.aksharbyonyks.com", "custom_domain": true }
  ],

  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "akshar-byonyks-web"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },

  // CPU TIME PER REQUEST IS THE ONE PLAN-RELEVANT NUMBER THIS PROJECT CANNOT
  // MEASURE LOCALLY, so it is recorded from the first deploy rather than
  // discovered after a 1102.
  //
  // The Workers Free plan allows 10 ms of CPU per HTTP request; Paid defaults
  // to 30 s. Exceeding the limit returns Error 1102 and logs the invocation
  // outcome as "exceededCpu". Cloudflare's stated average across all Workers
  // is 2.2 ms, but this worker serves prerendered pages through a full Next.js
  // server runtime (29 MB unbundled), so the average is not a safe proxy.
  //
  // `invocation_logs` is what carries `cpuTime` and `wallTime`. Sampling stays
  // at 1 (every request) — this site's request volume is nowhere near a level
  // where log volume is a cost, and a sampled tail would hide exactly the rare
  // spike that matters.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
